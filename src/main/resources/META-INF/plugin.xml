<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>de.paulmethfessel.lezer</id>
    <name>Lezer Grammar</name>
    <vendor>Paul Methfessel</vendor>
    <description><![CDATA[
        <p>Language support for <a href="https://lezer.codemirror.net/">Lezer</a> grammar files (<code>*.grammar</code>).</p>
        <ul>
            <li>Syntax highlighting with configurable colors</li>
            <li>Go to declaration, find usages and completion for rules, tokens, parameters, precedences, dialects and props</li>
            <li>Rename and safe delete refactorings</li>
            <li>Structure view and navigation bar</li>
            <li>Line and block commenting</li>
            <li>Code folding</li>
            <li>Quick documentation: comments before declarations, and short docs with guide links for keywords and built-ins</li>
            <li>Errors and warnings of <a href="https://github.com/lezer-parser/generator">@lezer/generator</a> while typing</li>
            <li>Run configuration to generate the parser, with a gutter icon on <code>@top</code></li>
            <li>Brace matching and quote auto-closing</li>
            <li>Code formatter</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Uses the Node.js interpreter configured for the project, if available -->
    <depends optional="true" config-file="lezer-javascript.xml">JavaScript</depends>

    <extensionPoints>
        <extensionPoint qualifiedName="de.paulmethfessel.lezer.nodeInterpreterProvider"
                        interface="de.paulmethfessel.lezer.generator.LezerNodeInterpreterProvider"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Lezer Grammar"
                  implementationClass="de.paulmethfessel.lezer.LezerFileType"
                  fieldName="INSTANCE"
                  language="Lezer"
                  extensions="grammar"/>
        <lang.parserDefinition language="Lezer"
                               implementationClass="de.paulmethfessel.lezer.parser.LezerParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Lezer"
                                       implementationClass="de.paulmethfessel.lezer.highlighting.LezerSyntaxHighlighterFactory"/>
        <annotator language="Lezer"
                   implementationClass="de.paulmethfessel.lezer.highlighting.LezerHighlightingAnnotator"/>
        <annotator language="Lezer"
                   implementationClass="de.paulmethfessel.lezer.annotator.LezerErrorAnnotator"/>
        <highlightErrorFilter implementation="de.paulmethfessel.lezer.annotator.LezerHighlightErrorFilter"/>
        <colorSettingsPage implementation="de.paulmethfessel.lezer.highlighting.LezerColorSettingsPage"/>
        <lang.commenter language="Lezer"
                        implementationClass="de.paulmethfessel.lezer.editor.LezerCommenter"/>
        <lang.foldingBuilder language="Lezer"
                             implementationClass="de.paulmethfessel.lezer.editor.LezerFoldingBuilder"/>
        <lang.braceMatcher language="Lezer"
                           implementationClass="de.paulmethfessel.lezer.editor.LezerBraceMatcher"/>
        <lang.quoteHandler language="Lezer"
                           implementationClass="de.paulmethfessel.lezer.editor.LezerQuoteHandler"/>
        <lang.documentationProvider language="Lezer"
                                    implementationClass="de.paulmethfessel.lezer.documentation.LezerDocumentationProvider"/>
        <lang.findUsagesProvider language="Lezer"
                                 implementationClass="de.paulmethfessel.lezer.findUsages.LezerFindUsagesProvider"/>
        <lang.refactoringSupport language="Lezer"
                                 implementationClass="de.paulmethfessel.lezer.refactoring.LezerRefactoringSupportProvider"/>
        <lang.namesValidator language="Lezer"
                             implementationClass="de.paulmethfessel.lezer.refactoring.LezerNamesValidator"/>
        <lang.psiStructureViewFactory language="Lezer"
                                      implementationClass="de.paulmethfessel.lezer.structure.LezerStructureViewFactory"/>
        <navbar implementation="de.paulmethfessel.lezer.structure.LezerNavBarModelExtension"/>
        <lang.formatter language="Lezer"
                        implementationClass="de.paulmethfessel.lezer.formatter.LezerFormattingModelBuilder"/>
        <langCodeStyleSettingsProvider
                implementation="de.paulmethfessel.lezer.formatter.LezerLanguageCodeStyleSettingsProvider"/>

        <!-- lezer-generator -->
        <externalAnnotator language="Lezer"
                           implementationClass="de.paulmethfessel.lezer.generator.LezerGeneratorAnnotator"/>
        <editorNotificationProvider implementation="de.paulmethfessel.lezer.generator.LezerGeneratorNotificationProvider"/>
        <projectConfigurable parentId="language"
                             instance="de.paulmethfessel.lezer.generator.LezerConfigurable"
                             id="de.paulmethfessel.lezer.settings"
                             displayName="Lezer Grammar"/>
        <notificationGroup id="Lezer Generator" displayType="BALLOON"/>
        <configurationType implementation="de.paulmethfessel.lezer.generator.run.LezerGeneratorConfigurationType"/>
        <runConfigurationProducer implementation="de.paulmethfessel.lezer.generator.run.LezerGeneratorRunConfigurationProducer"/>
        <runLineMarkerContributor language="Lezer"
                                  implementationClass="de.paulmethfessel.lezer.generator.run.LezerRunLineMarkerContributor"/>
    </extensions>
</idea-plugin>
